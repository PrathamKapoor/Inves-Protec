# SANGYAN .dockerignore — Strict build context hygiene
# Exclude version control and metadata
.git
.gitignore
.gitattributes
.github

# Exclude virtual environments and caches
venv
.venv
env
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
htmlcov

# Exclude test files and test fixtures (production image runtime hygiene)
tests/

# Exclude frozen research artifacts and papers
paper/
research/
*.tex
*.bib

# Exclude local database files and checkpoints
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
sangyan.db
test_*.db

# Exclude secrets, credentials, environment files, and keys
.env
.env.*
*.pem
*.key
*.secret
keys/

# Exclude build artifacts and logs
build/
dist/
*.egg-info
*.log
backups/
tmp/
