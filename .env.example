# ===========================================================================
# SANGYAN Environment Configuration Template (.env.example)
# Copy this file to .env and configure secrets before starting services.
# NEVER commit .env with production credentials to source control.
# ===========================================================================

# Runtime Environment (production | development | test)
SANGYAN_ENV=production

# Network & Server Binding
SANGYAN_HOST=0.0.0.0
SANGYAN_PORT=8000
SANGYAN_LOG_LEVEL=INFO

# Database Configuration
# SQLite local: sqlite:////app/data/sangyan.db
# PostgreSQL:  postgresql://sangyan_user:secret_password@postgres:5432/sangyan_prod
SANGYAN_DATABASE_URL=sqlite:////app/data/sangyan.db
SANGYAN_CHECKPOINT_DB_PATH=/app/checkpoints/workflow_checkpoints.db
SANGYAN_KEY_DIR=/app/keys
SANGYAN_AUTO_MIGRATE=false

# Authentication & Security Gateway (MANDATORY IN PRODUCTION)
# Generate via: openssl rand -hex 32
SANGYAN_JWT_SECRET=replace-with-at-least-32-byte-high-entropy-production-secret-hex
SANGYAN_JWT_ALGORITHMS=HS256
SANGYAN_JWT_ISSUER=sangyan-auth
SANGYAN_JWT_AUDIENCE=sangyan-api
SANGYAN_JWT_LEEWAY=30
SANGYAN_REQUIRE_AUTH=true

# CORS Allowed Origins (Comma-separated trusted domains; wildcard '*' is forbidden in production)
SANGYAN_ALLOWED_ORIGINS=https://sangyan.gov.in,https://app.sangyan.gov.in

# Transport & Rate Limiting
SANGYAN_MAX_REQUEST_BODY_BYTES=2097152
SANGYAN_RATE_LIMIT_ENABLED=true

# Automated Backup & Disaster Recovery
SANGYAN_BACKUP_DIR=/app/backups
# Generate via: openssl rand -hex 32
SANGYAN_BACKUP_ENCRYPTION_KEY=replace-with-secure-backup-encryption-key-for-aes-256-gcm
SANGYAN_BACKUP_RETENTION_COUNT=7
